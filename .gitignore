# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# proyectos de video (HyperFrames): se versiona la fuente, no la salida.
# Los MP4 y los PNG de contacto se regeneran con `npx hyperframes render`
# y `snapshot`; versionarlos engordaria el repo ~14 MB por pieza para siempre.
videos/*/renders/
videos/*/snapshots/
videos/*/.hyperframes/
videos/*/node_modules/
