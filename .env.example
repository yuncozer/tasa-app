# Ambas variables son opcionales: sin definirlas se usa $100 vía Pago Móvil
# como operación de referencia en VES (en COP se filtra solo por monto).

# Monto (en USD) de la operación de referencia usada para filtrar los anuncios
# de Binance P2P por transAmount, en VES y en COP.
BINANCE_REFERENCE_USD_AMOUNT=100

# Identificador de Binance para el método de pago usado en el filtro payTypes,
# solo en VES (ej. "PagoMovil", "Banesco", "BancoDeVenezuela").
BINANCE_REFERENCE_PAY_TYPE=PagoMovil

# Las siguientes cuatro son obligatorias solo para el post diario en
# Instagram (/api/cron/publish-instagram, ver README). Sin ellas, la
# aplicación funciona igual, ese endpoint simplemente no se usa.

# Secreto compartido con Vercel Cron: la ruta del cron solo publica si el
# header Authorization trae "Bearer <CRON_SECRET>".
CRON_SECRET=

# Dominio público de producción (sin barra final). Instagram necesita poder
# alcanzarlo desde fuera para buscar la imagen del post; no uses VERCEL_URL,
# que cambia por deployment.
SITE_URL=https://latasa.online

# ID numérico de la cuenta de Instagram Business y token de acceso de larga
# duración con permiso instagram_content_publish. Ver la sección de
# Instagram en el README para cómo obtenerlos.
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=
