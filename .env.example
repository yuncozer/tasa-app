# Ambas variables son opcionales: sin definirlas se usa $100 vía Pago Móvil
# como operación de referencia en VES (en COP se filtra solo por monto).

# Monto (en USD) de la operación de referencia usada para filtrar los anuncios
# de Binance P2P por transAmount, en VES y en COP.
BINANCE_REFERENCE_USD_AMOUNT=100

# Identificador de Binance para el método de pago usado en el filtro payTypes,
# solo en VES (ej. "PagoMovil", "Banesco", "BancoDeVenezuela").
BINANCE_REFERENCE_PAY_TYPE=PagoMovil

# Las siguientes cuatro son obligatorias solo para el post diario en
# Instagram (/api/cron/publish-instagram, ver README). Sin ellas, la
# aplicación funciona igual, ese endpoint simplemente no se usa.

# Secreto compartido con Vercel Cron: la ruta del cron solo publica si el
# header Authorization trae "Bearer <CRON_SECRET>".
CRON_SECRET=

# Dominio público de producción (sin barra final). Instagram necesita poder
# alcanzarlo desde fuera para buscar la imagen del post; no uses VERCEL_URL,
# que cambia por deployment.
SITE_URL=https://latasa.online

# ID numérico de la cuenta de Instagram Business y token de acceso de larga
# duración con permiso instagram_content_publish. Ver la sección de
# Instagram en el README para cómo obtenerlos.
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# Las dos siguientes son obligatorias solo para programar publicaciones desde
# /admin/noticia. Sin ellas todo lo demás funciona igual y el botón
# "Programar" es el único que falla.

# URL del proyecto de Supabase donde vive la cola (https://xxxx.supabase.co).
SUPABASE_URL=

# Clave service_role del mismo proyecto. Salta el RLS, así que es de servidor
# y solo de servidor: nunca con prefijo NEXT_PUBLIC_ ni en código de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Las tres siguientes son de los atajos del dominio (/hoy, /ig y /wa) y todas
# son opcionales.

# Respaldo de /hoy: a dónde lleva si el cron todavía no ha anotado el post del
# día en Supabase. Sin esto, /hoy cae al perfil.
ENLACE_HOY=

# Destino de /ig. Sin esto se usa el perfil que trae lib/atajos.ts.
PERFIL_INSTAGRAM_URL=https://www.instagram.com/latasa.online

# Destino de /wa (ej. https://wa.me/58XXXXXXXXXX). Sin esto la ruta /wa no
# existe: un número inventado llevaría a un chat ajeno.
ENLACE_WHATSAPP=

# Las dos siguientes son de la IA que redacta textos en /admin (OpenRouter) y
# las dos son opcionales: sin ellas los botones de "Redactar con IA" no
# aparecen y todo el texto sale de las plantillas de siempre.

# Clave de OpenRouter. Nunca llega al navegador: la IA solo se dispara desde
# rutas de /api/admin, protegidas por la cookie de sesión.
OPENROUTER_API_KEY=

# Modelos a probar, en orden, separados por comas. Van en el entorno y no en
# el código porque los ":free" de OpenRouter aparecen y se retiran sin aviso, y
# cambiar de modelo no puede exigir un despliegue. Si se deja vacía se usa la
# lista por defecto de lib/ia.ts.
OPENROUTER_MODELOS=google/gemma-4-31b-it:free,openai/gpt-oss-20b:free

# Render del video de tasas en la nube de HeyGen, para que el generador de
# /admin funcione desde el teléfono: en Vercel no hay Chromium ni ffmpeg.
# La plantilla se sube UNA vez con `npx hyperframes cloud render videos/tasas-del-dia`,
# que imprime el asset_id; sin estas dos, /admin/video cae al render local.
HEYGEN_API_KEY=
HYPERFRAMES_ASSET_ID=

# Avisos por correo, vía Resend. Son de conveniencia: sin estas variables no se
# manda ninguno y todo lo demás funciona igual —lo que se avisa sigue estando
# en /admin—. Llegan cuando hay un borrador nuevo de La Parada, cuando el cron
# no pudo publicar el post del día, cuando una publicación programada falla y
# cuando no se pudo renovar el token de Instagram.
RESEND_API_KEY=
RESEND_FROM=
# NOTIFICAR_PARADA_EMAIL se sigue aceptando por compatibilidad con la
# configuración anterior, cuando el único aviso era el de La Parada.
NOTIFICAR_EMAIL=

# Sube este número para invalidar de golpe todas las sesiones abiertas de
# /admin sin cambiar ADMIN_PASSWORD. El token de sesión lleva la versión
# firmada dentro, así que las cookies emitidas con la anterior dejan de
# valer en el próximo despliegue. Sin definir vale 1.
SESSION_VERSION=1

# Secreto con el que se firman los parámetros de /api/og/instagram-post-news.
# Sin definir se cae a CRON_SECRET, que es como funcionó siempre; ponerlo
# separa de verdad los dos secretos, de modo que rotar la firma de las
# imágenes no obligue a rotar además el acceso a publicar (o sea, a tocar
# cron-job.org en la misma maniobra).
FIRMA_IMAGENES_SECRET=

# Claves de la API de datos (/api/rates, sus tres rutas por proveedor y
# /api/convert), separadas por comas. Sin esta variable **no entra nadie**:
# igual que CRON_SECRET, un despliegue con la variable mal copiada tiene que
# dejar la puerta cerrada y no abierta de par en par.
#
# Estuvieron abiertas y sin clave, así que cualquiera podía montar una app
# encima de estas tasas. Ver la sección de monetización en CLAUDE.md: el
# histórico con mañana y tarde separadas es lo que aquí se puede vender, y dar
# de alta a un cliente es añadir su clave a esta lista.
#
# /api/health y /api/eventos siguen abiertas a propósito, y ahí se explica por qué.
API_KEYS=

# Claves VAPID de los avisos push ("ya están las tasas de hoy"). Se generan una
# sola vez con `npx web-push generate-vapid-keys` y no se rotan salvo que haga
# falta: cambiarlas invalida **todas** las suscripciones guardadas, y quien las
# tenía deja de recibir avisos sin enterarse.
# Si algún día hay que rotarlas de verdad, la receta para no tumbar a nadie
# está en CLAUDE.md ("Rotar las claves VAPID sin tumbar las suscripciones").
#
# La pública viaja al navegador a propósito (de ahí el prefijo NEXT_PUBLIC_):
# sirve para que el servidor push compruebe quién firmó el aviso, no para
# mandar nada. La privada nunca sale del servidor.
#
# Sin las dos configuradas, `avisarTasasDelDia()` no manda nada y el cron
# publica igual — mismo criterio que RESEND_API_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
