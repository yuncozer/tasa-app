{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "$PWD/.claude/branch-enforcer.sh",
            "statusMessage": "Verificando branch allowlist..."
          }
        ]
      }
    ]
  }
}
