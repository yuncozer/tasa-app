# Salidas del render, no fuentes: se regeneran con
# `npx tsx scripts/video-tasas.ts --render`.
/renders/
/snapshots/

# Las variables del día las escribe el script en cada corrida; versionarlas
# dejaría las tasas de un día suelto en el repositorio.
/variables.json

# El base64 intermedio de la fuente: ya va embebido dentro de index.html.
/assets/geist-latin.b64

# Respaldos automáticos que el Studio deja al editar: son copias de index.html,
# no fuentes.
/.hyperframes/

# Miniaturas que el Studio genera para su línea de tiempo: caché de la
# herramienta, se rehacen solas.
/.thumbnails/
